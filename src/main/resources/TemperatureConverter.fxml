<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="root" spacing="12" style="-fx-background-color: #f3f5f4; -fx-font-size: 14px;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="TemperatureConverterController">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <Label fx:id="titleLabel" text="%app.title" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label fx:id="languageLabel" text="%language.label"/>
    <ComboBox fx:id="languageChoice" maxWidth="Infinity" onAction="#changeLanguage"/>
    <Label fx:id="conversionLabel" text="%conversion.label"/>
    <ComboBox fx:id="conversionChoice" maxWidth="Infinity"/>
    <Label fx:id="temperatureLabel" text="%temperature.label"/>
    <TextField fx:id="inputField" text="32" promptText="%temperature.prompt"/>
    <Button text="%convert.button" onAction="#convertTemperature" defaultButton="true"/>
    <Label fx:id="resultLabel" text="%result.empty" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label fx:id="rangeLabel" text="%range.normal" wrapText="true"/>
</VBox>